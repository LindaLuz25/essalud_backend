    (1, 1, 1),  -- radiografía obligatoria
    (1, 2, 0);  -- análisis de sangre recomendado, no obligatorio

-- Búsqueda rápida de horarios disponibles por médico/fecha (pantalla de agendamiento)
CREATE INDEX idx_horario_estado_fecha
    ON horario_medico (estado, fecha, hora_inicio);

-- Acelera el JOIN horario_medico -> medico dentro de la búsqueda por especialidad
CREATE INDEX idx_horario_medico_cmp
    ON horario_medico (cmp_medico, estado);

-- Búsqueda de médicos activos por especialidad
CREATE INDEX idx_medico_especialidad
    ON medico (id_especialidad, activo);

-- Job de "no confirmación 24h antes": localizar citas pendientes por vencer
CREATE INDEX idx_cita_estado_registro
    ON cita (estado, fecha_registro);

-- Acceso directo por paciente (historial / "mis citas")
CREATE INDEX idx_cita_paciente
    ON cita (dni_paciente, estado);

-- Cola de espera: siguiente candidato a notificar (orden FIFO) por especialidad activa
CREATE INDEX idx_espera_especialidad_estado_fecha
    ON lista_espera (id_especialidad, estado, fecha_registro);

-- Búsqueda de la posición de un paciente en su cola de espera
CREATE INDEX idx_espera_paciente_estado
    ON lista_espera (dni_paciente, estado);








